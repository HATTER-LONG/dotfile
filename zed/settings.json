// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Material Icon Theme",
  "agent_ui_font_size": 16.0,
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cargo\\s+check(\\s|$)"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
      "effort": "max",
    },
    "dock": "right",
    "sidebar_side": "right",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato",
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 1024,
      "prompt_format": "deepseek_coder",
      "model": "deepseek-v4-flash",
      "api_url": "https://api.deepseek.com/beta/completions",
    },
    "provider": "open_ai_compatible_api",
  },
  "colorize_brackets": true,
  "theme_overrides": {
    "Catppuccin Macchiato": {
      "accents": [
        "#ff6e6eff",
        "#5ec7ffff",
        "#ffa657ff",
        "#7a8bffff",
        "#a7e35bff",
        "#c58cffff",
        "#5ed3b3ff",
        "#ff8ccfff",
        "#ffd75aff",
        "#ff99a8ff",
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
      },
      "editor.debugger_active_line.background": "#ff634750",
      "editor.active_line.background": "#ADD8E610",
    },
  },
}
